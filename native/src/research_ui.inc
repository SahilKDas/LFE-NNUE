struct ResearchRect {float left,top,right,bottom;bool contains(float x,float y)const{return x>=left&&x<right&&y>=top&&y<bottom;}};
ResearchRect researchFieldRect(int index,float width){const float column=(width-64)/2,left=24+(index%2)*(column+16),top=198+(index/2)*54;return {left,top,left+column,top+29};}
float researchActionY(){return 198+float((researchFields[researchPage].size()+1)/2)*54;}
std::vector<std::string> researchActions(){switch(researchPage){case 0:return {"Checkpoint","Seek","Present","Branch","Cancel"};case 1:return {"Run pair","Activate","Checkpoint","Cancel","Intervention"};case 2:return {"Selected L","Selected R","Compare","Save genome","Parent"};case 3:return {"Search","Filter","Inspect","Genome","Rewind","Atlas"};default:return {"Save genome","Save world","Load world","Introduce","Compare","Import..."};}}
int researchNumber(int index,int low,int high){const auto& value=researchFields[researchPage].at(index).value;size_t used{};int number=std::stoi(value,&used);if(used!=value.size()||number<low||number>high)throw std::runtime_error("Invalid "+researchFields[researchPage][index].label);return number;}
