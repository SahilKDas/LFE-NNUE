const char* researchFeatureGroup(uint32_t row){if(row<life::PositionCount*life::FeatureCategories)return "Occupancy/resource/terrain";if(row<life::LegacyInputSize)return "Internal/climate";if(row<life::CarrionDensityFeatureOffset)return "Nutrients";if(row<life::ResearchFeatureOffset)return "Carrion density";if(row<life::SignalBFeatureOffset)return "Signal A";if(row<life::StageFeatureOffset)return "Signal B";if(row<life::InfectionFeatureOffset)return "Development";if(row<life::InputSize)return "Infection";return "Hidden/output";}
void researchBody(life::skia::Api::Canvas canvas,life::skia::Api::Paint paint,const life::GenomeRecord& genome,float left,float top,float width,float height){if(genome.body.empty())return;int minX=genome.body[0].x,maxX=minX,minY=genome.body[0].y,maxY=minY;for(const auto& c:genome.body){minX=std::min(minX,c.x);maxX=std::max(maxX,c.x);minY=std::min(minY,c.y);maxY=std::max(maxY,c.y);}const float scale=std::min({16.f,width/(maxX-minX+1),height/(maxY-minY+1)});for(const auto& c:genome.body){const float x=left+(c.x-minX)*scale,y=top+(c.y-minY)*scale;rectangle(canvas,paint,x,y,x+std::max(1.f,scale-1),y+std::max(1.f,scale-1),cellColors[int(c.type)]);}}
