bool researchClick(HWND window,int x,int y,float width,float height){if(!researchOpen||x>=width||y<82||y>=height-28)return false;if(y>=148&&y<179){researchPage=std::clamp(int((x-24)/((width-48)/5)),0,4);researchFocus=-1;researchScroll=0;researchSelected=-1;return true;}for(int i=0;i<int(researchFields[researchPage].size());++i)if(researchFieldRect(i,width).contains(float(x),float(y))){researchFocus=i;researchCaret=researchFields[researchPage][i].value.size();return true;}researchFocus=-1;const auto actions=researchActions();if(y>=researchActionY()&&y<researchActionY()+30&&x>=24&&x<width-24){const int action=int((x-24)/((width-48)/actions.size()));if(researchPage==4&&action==5){wchar_t filename[32768]{};OPENFILENAMEW dialog{};dialog.lStructSize=sizeof(dialog);dialog.hwndOwner=window;dialog.lpstrFile=filename;dialog.nMaxFile=32768;dialog.lpstrFilter=L"Research files (*.lfegenome;*.lfesave)\0*.lfegenome;*.lfesave\0\0";dialog.Flags=OFN_NOCHANGEDIR|OFN_FILEMUSTEXIST|OFN_PATHMUSTEXIST;if(GetOpenFileNameW(&dialog))researchSuite->importLibrary(filename);}else researchAction(action);return true;}const int row=int((y-(researchActionY()+51)+14)/23)+researchScroll;if(researchPage==1)researchSelected=row-2;else if(researchPage==3||researchPage==4)researchSelected=row-1;return true;}
bool researchKey(UINT message,WPARAM key){if(!researchOpen||researchFocus<0)return false;auto& fields=researchFields[researchPage];auto& value=fields[size_t(researchFocus)].value;if(message==WM_KEYDOWN){if(key==VK_ESCAPE){researchFocus=-1;return true;}if(key==VK_TAB){researchFocus=(researchFocus+1)%int(fields.size());researchCaret=fields[size_t(researchFocus)].value.size();return true;}if(key==VK_RETURN){researchAction(researchPage==0?1:researchPage==2?2:0);return true;}if(key==VK_HOME)researchCaret=0;else if(key==VK_END)researchCaret=value.size();else if(key==VK_LEFT&&researchCaret){do{--researchCaret;}while(researchCaret&&(uint8_t(value[researchCaret])&0xc0)==0x80);}else if(key==VK_RIGHT&&researchCaret<value.size()){do{++researchCaret;}while(researchCaret<value.size()&&(uint8_t(value[researchCaret])&0xc0)==0x80);}return true;}if(message==WM_CHAR){if(key==8&&researchCaret){const size_t end=researchCaret;do{--researchCaret;}while(researchCaret&&(uint8_t(value[researchCaret])&0xc0)==0x80);value.erase(researchCaret,end-researchCaret);}else if(key>=32&&key<0xd800&&value.size()<256){const wchar_t wide=wchar_t(key);char utf8[4]{};const int count=WideCharToMultiByte(CP_UTF8,0,&wide,1,utf8,4,nullptr,nullptr);value.insert(researchCaret,utf8,count);researchCaret+=count;}return true;}return false;}
