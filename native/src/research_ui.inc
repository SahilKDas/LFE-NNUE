 const float first=y;const int visible=std::max(0,int(((researchPage==1&&s.branches.size()>=2&&height>780?height-300:height-65)-y)/23));for(int row=0;row<visible&&row+researchScroll<int(lines.size());++row){const int index=row+researchScroll;const bool selected=researchSelected>=0&&((researchPage==1&&index-2==researchSelected)||(researchPage==3&&index-1==researchSelected)||(researchPage==4&&index-1==researchSelected));if(selected)rectangle(canvas,paint,20,y-14,width-20,y+7,0xff3a4b68);text(canvas,paint,lines[size_t(index)].substr(0,size_t(std::max(20.f,(width-55)/6))),24,y,width<900?10:11,selected?0xffe5c56f:0xffb8c3d1);y+=23;}(void)first;text(canvas,paint,s.busy?"Working... Cancel is available for seeks and experiments.":"R closes | click fields to edit | Enter applies | wheel scrolls",24,height-39,10,0xff81d2c7);
