inline void genomeArchive(StateArchive& a,GenomeRecord& g){a.fields(g.version,g.brainId,g.source.run,g.source.branch,g.source.id,g.generation,g.name,g.notes,g.provenance,g.body,g.moveRange,g.birthDistance,g.mutability,g.radius,g.channels,g.neuralMutability,g.oxygenTolerance,g.respiratoryRecovery,g.frailty);genes(a,g.genes);if(g.version!=1||g.body.empty()||g.body.size()>4096||g.moveRange<1||g.moveRange>10000||g.birthDistance<1||g.birthDistance>10000||g.mutability<1||g.mutability>100||!std::isfinite(g.neuralMutability)||g.neuralMutability<0||g.neuralMutability>100||!std::isfinite(g.oxygenTolerance)||g.oxygenTolerance<.08||g.oxygenTolerance>.16||!std::isfinite(g.respiratoryRecovery)||g.respiratoryRecovery<.002||g.respiratoryRecovery>.025||!std::isfinite(g.frailty)||g.frailty<.35||g.frailty>2)throw std::runtime_error("Invalid genome traits");const auto perception=clampPerception(g.radius,g.channels);if(perception.radius!=g.radius||perception.channels!=g.channels)throw std::runtime_error("Genome exceeds sensory compute budget");std::unordered_set<uint64_t> occupied;bool mover=false;for(const auto& c:g.body){if(c.type<CellType::Mouth||c.type>CellType::DecomposerMouth||std::abs(int64_t(c.x))>1024||std::abs(int64_t(c.y))>1024||!occupied.insert((uint64_t(uint32_t(c.x))<<32)|uint32_t(c.y)).second)throw std::runtime_error("Invalid genome body");mover|=c.type==CellType::Mover;}bool network=bool(g.neural);a(network);if(network){auto data=a.reading?std::make_shared<Nnue::Weights>():std::make_shared<Nnue::Weights>(*g.neural);weights(a,*data);if(a.reading)g.neural=data;}if(network!=mover)throw std::runtime_error("Genome movement topology mismatch");}
}
void NativeSimulation::saveGenome(const GenomeRecord& source,const std::filesystem::path& path){if(std::filesystem::exists(path))throw std::runtime_error("Library item already exists");auto temporary=path;temporary+=".tmp";try{std::fstream file(temporary,std::ios::out|std::ios::binary|std::ios::trunc);if(!file)throw std::runtime_error("Cannot create genome file");StateArchive a{file,false};uint64_t magic=0x31454d4f4e45474cULL;uint32_t inputs=InputSize;a.fields(magic,inputs);auto g=source;research_detail::genomeArchive(a,g);const uint64_t hash=a.checksum;file.write(reinterpret_cast<const char*>(&hash),8);file.flush();if(!file)throw std::runtime_error("Cannot write genome file");file.close();std::filesystem::rename(temporary,path);}catch(...){std::error_code ec;std::filesystem::remove(temporary,ec);throw;}}
GenomeRecord NativeSimulation::loadGenome(const std::filesystem::path& path){if(std::filesystem::file_size(path)>16u*1024u*1024u)throw std::runtime_error("Genome file too large");verifySaveChecksum(path);std::fstream file(path,std::ios::in|std::ios::binary);StateArchive a{file,true};uint64_t magic{};uint32_t inputs{};a.fields(magic,inputs);if(magic!=0x31454d4f4e45474cULL||(inputs!=InputSize&&inputs!=ResearchFeatureOffset))throw std::runtime_error("Unsupported genome file");GenomeRecord g;research_detail::genomeArchive(a,g);uint64_t hash{};file.read(reinterpret_cast<char*>(&hash),8);if(!file||hash!=a.checksum||file.peek()!=std::char_traits<char>::eof())throw std::runtime_error("Corrupt genome file");return g;}
int NativeSimulation::introduceGenome(const GenomeRecord& g,int x,int y,const std::string& artifact){auto checked=g;std::stringstream validation(std::ios::in|std::ios::out|std::ios::binary);StateArchive check{validation,false};research_detail::genomeArchive(check,checked);if(safeIndex(x,y)<0||!isClearBody(g.body,nextId_,x,y,0))return -1;Organism child;child.id=nextId_++;child.x=x;child.y=y;child.cells=g.body;child.mutability=g.mutability;child.neuralMutability=g.neuralMutability;child.moveRange=g.moveRange;child.birthDistance=g.birthDistance;child.perceptionRadius=g.radius;child.senseChannels=g.channels;child.neuralCost=clampPerception(g.radius,g.channels).cost;child.oxygenTolerance=g.oxygenTolerance;child.stressRecovery=g.respiratoryRecovery;child.frailty=g.frailty;child.research->genes=g.genes;child.research->importedFrom=g.provenance.empty()?g.name:g.provenance;child.lineage->birthTick=ticks_;child.lineage->mutations.push_back("Introduced from library: "+child.research->importedFrom);if(g.neural){child.brain=Nnue::fromGenome(g.neural);child.brainGenomeId=nextBrainGenomeId_++;}refreshCapabilities(child);child.activeIndex=activeSlots_.size();const int id=child.id;activeSlots_.push_back(organisms_.size());organisms_.push_back(std::move(child));slotById_[id]=organisms_.size()-1;placeBody(organisms_.back());registerAtmosphere(organisms_.back(),1);largest_=std::max(largest_,int(g.body.size()));rebuildRegionIndex();recordCommand({0,ticks_,CommandKind::Introduce,x,y,0,0,artifact});addJournal(JournalKind::Introduction,id,"Organism introduced",organisms_.back().research->importedFrom);return id;}
ResearchEcology NativeSimulation::researchEcology()const{ResearchEcology r;r.tick=ticks_;r.population=int(activeSlots_.size());r.births=births_;r.deaths=deadCount_;r.diseaseDeaths=diseaseDeaths_;r.hatched=hatches_;r.matured=maturations_;for(size_t slot:activeSlots_)if(slot!=SIZE_MAX&&slot<organisms_.size()&&organisms_[slot].living){const auto& o=organisms_[slot];r.eggs+=o.research->development.stage==LifeStage::Egg;r.juveniles+=o.research->development.stage==LifeStage::Juvenile;r.infected+=o.research->infection.load>0;r.immune+=o.research->infection.protectedUntil>ticks_;}for(auto value:signals_[0])r.signalA+=value;for(auto value:signals_[1])r.signalB+=value;return r;}
size_t NativeSimulation::freezeBytes()const{size_t bytes=65536+cells.size()*40+organisms_.size()*(sizeof(Organism)+sizeof(OrganismLineage)*2+512)+timeline_.size()*sizeof(EcologySample)+journal_.size()*512+classificationCache_.storageBytes()+species_.size()*sizeof(SpeciesSummary)*2+watchedDecisions_.size()*sizeof(DecisionRecord);for(const auto& o:organisms_){bytes+=(o.cells.size()+o.research->development.matureBody.size())*sizeof(BodyCell)*4+o.lastFeatures.size()*8+o.lineage->mutations.size()*96;for(const auto& text:o.lineage->mutations)bytes+=text.size()*2;}for(const auto& c:commands_)bytes+=sizeof(c)+c.artifact.size()*2;for(const auto& j:journal_)bytes+=(j.label.size()+j.evidence.size())*2;return bytes;}
std::shared_ptr<NativeSimulation> NativeSimulation::freeze(size_t budget)const{if(freezeBytes()>budget)return {};auto result=std::make_shared<NativeSimulation>(*this);result->analysisPool_.reset();result->parallelAnalysis_=false;result->classificationMatches_.clear();result->classificationJobs_.clear();result->classificationBuffer_.clear();result->classificationCache_.invalidate();std::unordered_map<const Nnue*,std::shared_ptr<Nnue>> copies;for(auto& o:result->organisms_)if(o.brain){auto [it,inserted]=copies.try_emplace(o.brain.get());if(inserted)it->second=o.brain->cloneRuntime();o.brain=it->second;}result->watchedDecisions_.clear();result->decisionCount_=result->decisionCursor_=0;return result;}
uint64_t NativeSimulation::stateDigest()const{uint64_t hash=1469598103934665603ULL;const auto add=[&](uint64_t value){hash=research_detail::mix(hash,value);};const auto floating=[&](double value){add(std::bit_cast<uint64_t>(value));};add(random_.checkpoint());add(developmentRandom_.checkpoint());add(diseaseRandom_.checkpoint());add(ticks_);add(nextId_);add(births_);add(deadCount_);floating(atmosphericOxygen_);floating(carbonDioxide_);for(size_t i=0;i<cells.size();++i){add(cells[i]);add(uint32_t(owners[i]));add(world.terrain[i]);add(world.resources[i]);add(world.resourceAmount[i]);add(world.nutrients[i]);}for(const auto& o:organisms_){add(o.id);add(o.parentId);add(o.living);add(o.x);add(o.y);add(o.energy);add(o.minerals);add(o.lifetime);add(o.damage);add(o.direction);add(o.rotation);floating(o.hypoxiaStress);floating(o.thermalStress);for(const auto& c:o.cells){add(int(c.type));add(c.x);add(c.y);add(c.durability);}if(o.brain){add(o.brain->signature());for(auto v:o.brain->accumulator)add(std::bit_cast<uint32_t>(v));for(auto v:o.brain->active)add(v);for(auto v:o.brain->output)add(std::bit_cast<uint32_t>(v));add(o.brain->outputValid_);}add(o.research->genes.incubation);add(o.research->genes.investment);add(o.research->genes.shell);add(o.research->genes.growthInterval);for(auto v:o.research->genes.emission)add(v);floating(o.research->genes.resistance);floating(o.research->genes.infectionRecovery);floating(o.research->infection.load);floating(o.research->infection.stress);floating(o.research->infection.risk);add(o.research->infection.protectedUntil);add(int(o.research->development.stage));add(o.research->development.ticks);add(o.research->development.growthTicks);for(const auto& c:o.research->development.matureBody){add(int(c.type));add(c.x);add(c.y);}}for(const auto& layer:signals_)for(auto v:layer)add(v);add(diseaseDeaths_);add(lastDiseaseDeath_);add(hatches_);add(maturations_);for(const auto& species:species_){add(species.id);add(species.parentId);add(species.population);add(species.peakPopulation);add(species.extinct);add(species.missingScans);add(species.representative.bodyHash);add(species.representative.neuralSignature);for(auto v:species.representative.researchTraits)add(v);}for(const auto& sample:timeline_){add(sample.tick);add(sample.population);add(sample.births);for(auto death:sample.deaths)add(death);add(sample.plant);add(sample.carrion);add(sample.mineral);add(sample.soilNutrients);}for(const auto& event:evolutionEvents_){add(int(event.type));add(event.tick);add(event.speciesId);for(char c:event.label)add(uint8_t(c));}return hash;}
void NativeSimulation::archiveResearch(StateArchive& a){uint32_t development=developmentRandom_.checkpoint(),disease=diseaseRandom_.checkpoint();a.fields(development,disease,commandSequence_,worldEpoch_,runId_,branchId_,journalSequence_,diseaseDeaths_,lastDiseaseDeath_,hatches_,maturations_);if(a.reading){developmentRandom_.restore(development);diseaseRandom_.restore(disease);}uint64_t count=commands_.size();a(count);if(count>65536)throw std::runtime_error("Invalid command history size");if(a.reading)commands_.resize(count);for(auto& c:commands_)a.fields(c.sequence,c.tick,c.kind,c.x,c.y,c.value,c.amount,c.artifact);count=journal_.size();a(count);if(count>20000)throw std::runtime_error("Invalid journal size");if(a.reading)journal_.resize(count);for(auto& j:journal_)a.fields(j.sequence,j.run,j.branch,j.firstTick,j.lastTick,j.organism,j.species,j.count,j.kind,j.label,j.evidence);a(researchTimeline_);for(auto& layer:signals_){a(layer);if(layer.size()!=size_t((width_+7)/8)*((height_+7)/8)||std::any_of(layer.begin(),layer.end(),[](auto v){return v>4095;}))throw std::runtime_error("Invalid chemical field");}if(researchTimeline_.size()>24000)throw std::runtime_error("Invalid research timeline");for(auto& o:organisms_){int id=o.id;a(id);if(id!=o.id)throw std::runtime_error("Invalid research organism reference");research_detail::genes(a,o.research->genes);a.fields(o.research->development.stage,o.research->development.ticks,o.research->development.growthTicks,o.research->development.matureBody,o.research->infection.load,o.research->infection.stress,o.research->infection.risk,o.research->infection.protectedUntil,o.research->importedFrom);if(o.research->development.stage>LifeStage::Juvenile||o.research->development.matureBody.size()>4096||!std::isfinite(o.research->infection.load)||o.research->infection.load<0||o.research->infection.load>1||!std::isfinite(o.research->infection.stress)||!std::isfinite(o.research->infection.risk))throw std::runtime_error("Invalid development/infection state");}}
