void NativeSimulation::recordCommand(SimulationCommand command){if(!recordingCommands_)return;command.sequence=++commandSequence_;command.tick=ticks_;if(commands_.size()>=65536)commands_.erase(commands_.begin(),commands_.begin()+4096);commands_.push_back(std::move(command));}
void NativeSimulation::applyCommand(const SimulationCommand& command){if(command.tick!=ticks_)throw std::runtime_error("Command tick does not match replay position");const bool previous=recordingCommands_;recordingCommands_=false;try{bool ok=false;switch(command.kind){case CommandKind::Terrain:ok=command.value>=0&&command.value<=int(TerrainType::Mountain)&&paintTerrain(command.x,command.y,TerrainType(command.value));break;case CommandKind::Resource:ok=command.amount>=0&&command.amount<=65535&&command.value>=0&&command.value<=int(ResourceType::Mineral)&&paintResource(command.x,command.y,ResourceType(command.value),uint16_t(command.amount));break;case CommandKind::Nutrients:ok=command.amount>=0&&command.amount<=65535&&paintNutrients(command.x,command.y,uint16_t(command.amount));break;case CommandKind::Regenerate:ok=true;regenerate(uint32_t(command.value));break;case CommandKind::Reset:ok=true;reset();break;case CommandKind::Configure:ok=true;if(command.x==0&&command.value>=0&&command.value<=10000)foodChance_=command.value/10000.;else if(command.x==1&&command.value>0)lifespan_=command.value;else ok=false;break;case CommandKind::Introduce:ok=introduceGenome(loadGenome(command.artifact),command.x,command.y,command.artifact)>=0;break;}if(!ok)throw std::runtime_error("Invalid replay command");commandSequence_=command.sequence;if(previous){if(commands_.size()>=65536)commands_.erase(commands_.begin(),commands_.begin()+4096);commands_.push_back(command);}recordingCommands_=previous;}catch(...){recordingCommands_=previous;throw;}}
void NativeSimulation::addJournal(JournalKind kind,int organism,const std::string& label,const std::string& evidence){if(!journal_.empty()){auto& last=journal_.back();if(last.kind==kind&&last.label==label&&last.organism==organism&&ticks_-last.lastTick<=60){last.lastTick=ticks_;++last.count;return;}}if(journal_.size()>=20000)journal_.erase(journal_.begin(),journal_.begin()+1000);const auto* source=organismById(organism);journal_.push_back({++journalSequence_,runId_,branchId_,ticks_,ticks_,organism,source?source->speciesId:-1,1,kind,label,evidence});}
GenomeRecord NativeSimulation::genomeRecord(int id)const{const auto* o=organismById(id);if(!o)throw std::runtime_error("Genome not retained");GenomeRecord g;g.source={runId_,branchId_,id};g.brainId=o->brainGenomeId;g.generation=o->lineage->generation;g.birthTick=o->lineage->birthTick;g.deathTick=o->lineage->deathTick;g.offspring=o->lineage->directOffspring;g.descendants=o->lineage->totalDescendants;g.body=o->research->development.matureBody.empty()?o->cells:o->research->development.matureBody;for(auto& cell:g.body)cell.durability=cell.type==CellType::Killer?KillerDurability:cell.type==CellType::Armor?ArmorDurability:0;g.moveRange=o->moveRange;g.birthDistance=o->birthDistance;g.mutability=o->mutability;g.neuralMutability=o->neuralMutability;g.radius=o->perceptionRadius;g.channels=o->senseChannels;g.oxygenTolerance=o->oxygenTolerance;g.respiratoryRecovery=o->stressRecovery;g.frailty=o->frailty;g.genes=o->research->genes;g.provenance=o->research->importedFrom;g.name="Organism #"+std::to_string(id);if(o->brain)g.neural=o->brain->genome();return g;}
GenomeComparison NativeSimulation::compareGenomes(const GenomeRecord& a,const GenomeRecord& b){GenomeComparison out;const auto trait=[&](const char* name,auto x,auto y){if(x!=y){std::ostringstream text;text<<name<<": "<<+x<<" -> "<<+y;out.traits.push_back(text.str());}};trait("Body cells",a.body.size(),b.body.size());size_t bodyChanges=0;for(size_t i=0;i<std::min(a.body.size(),b.body.size());++i)bodyChanges+=a.body[i].type!=b.body[i].type||a.body[i].x!=b.body[i].x||a.body[i].y!=b.body[i].y;trait("Body positions/types changed",size_t(0),bodyChanges);trait("Movement range",a.moveRange,b.moveRange);trait("Birth distance",a.birthDistance,b.birthDistance);trait("Radius",a.radius,b.radius);trait("Channels",a.channels,b.channels);trait("Body mutation",a.mutability,b.mutability);trait("Neural mutation",a.neuralMutability,b.neuralMutability);trait("Oxygen tolerance",a.oxygenTolerance,b.oxygenTolerance);trait("Respiratory recovery",a.respiratoryRecovery,b.respiratoryRecovery);trait("Frailty",a.frailty,b.frailty);trait("Incubation",a.genes.incubation,b.genes.incubation);trait("Investment",a.genes.investment,b.genes.investment);trait("Shell",a.genes.shell,b.genes.shell);trait("Growth interval",a.genes.growthInterval,b.genes.growthInterval);trait("Signal A",a.genes.emission[0],b.genes.emission[0]);trait("Signal B",a.genes.emission[1],b.genes.emission[1]);trait("Resistance",a.genes.resistance,b.genes.resistance);trait("Infection recovery",a.genes.infectionRecovery,b.genes.infectionRecovery);
 if(bool(a.neural)!=bool(b.neural))out.traits.push_back("Movement network added/removed");if(a.neural&&b.neural){const auto difference=[&](uint32_t row,auto left,auto right){WeightDifference d{row};for(size_t i=0;i<left.size();++i)if(std::bit_cast<uint32_t>(left[i])!=std::bit_cast<uint32_t>(right[i])){++d.changed;d.magnitude+=std::abs(double(left[i])-right[i]);}if(d.changed){out.changedWeights+=d.changed;out.magnitude+=d.magnitude;out.rows.push_back(d);}};for(uint32_t i=0;i<InputSize;++i)difference(i,a.neural->input[i],b.neural->input[i]);difference(InputSize,a.neural->hidden,b.neural->hidden);for(uint32_t i=0;i<OutputSize;++i)difference(InputSize+1+i,a.neural->output[i],b.neural->output[i]);difference(InputSize+1+OutputSize,a.neural->bias,b.neural->bias);std::sort(out.rows.begin(),out.rows.end(),[](const auto& x,const auto& y){return x.magnitude!=y.magnitude?x.magnitude>y.magnitude:x.row<y.row;});if(out.rows.size()>32)out.rows.resize(32);}return out;
}
