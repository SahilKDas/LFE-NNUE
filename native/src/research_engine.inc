inline void genes(StateArchive& a,ResearchGenes& g){a.fields(g.incubation,g.investment,g.shell,g.growthInterval,g.emission,g.resistance,g.infectionRecovery);if(g.incubation>240||g.investment>800||g.investment<100||g.shell>32||g.growthInterval<1||g.growthInterval>240||!std::isfinite(g.resistance)||g.resistance<0||g.resistance>1||!std::isfinite(g.infectionRecovery)||g.infectionRecovery<.001||g.infectionRecovery>.1||g.emission[0]>16||g.emission[1]>16)throw std::runtime_error("Invalid inherited research traits");}
inline void weights(StateArchive& a,Nnue::Weights& w){a.fields(w.input,w.hidden,w.output,w.bias);if(a.reading&&w.input.size()==ResearchFeatureOffset)w.input.resize(InputSize);if(w.input.size()!=InputSize)throw std::runtime_error("Incompatible genome topology");if(a.reading){const auto finite=[](float f){if(!std::isfinite(f)||std::abs(f)>1e6f)throw std::runtime_error("Invalid neural weight");};for(const auto& row:w.input)for(float f:row)finite(f);for(float f:w.hidden)finite(f);for(const auto& row:w.output)for(float f:row)finite(f);for(float f:w.bias)finite(f);}}
inline uint64_t mix(uint64_t hash,uint64_t value){hash^=value;return hash*1099511628211ULL;}
